# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL bootstrap (Docker entrypoint admin; creates other roles) ---
POSTGRES_DB=auth_foundation
POSTGRES_USER=auth_bootstrap
POSTGRES_PASSWORD=change-me-bootstrap-local
POSTGRES_PORT=5432

# --- Migration / owner role (Flyway; owns tables) ---
DB_OWNER_USER=auth_owner
DB_OWNER_PASSWORD=change-me-owner-local

# --- Runtime application role (Spring datasource; non-owner) ---
DB_APP_USER=auth_app
DB_APP_PASSWORD=change-me-app-local

# --- Audit retention role (EXECUTE on purge function only; no table DELETE) ---
DB_RETENTION_USER=auth_retention
DB_RETENTION_PASSWORD=change-me-retention-local
# AUDIT_RETENTION_ENABLED=false
# AUDIT_RETENTION_DAYS=365

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS=

# --- Frontends (Compose profiles; use ONE at a time for auth testing) ---
# ANGULAR_PORT=4200
# REACT_PORT=5173
# docker compose --profile angular up --build
# docker compose --profile react up --build

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Browser security (Phase 6+) ---
# CORS_ALLOWED_ORIGIN=https://app.example.com

# --- Bootstrap first SUPER_ADMIN (Phase 7; disable after first successful start) ---
BOOTSTRAP_ENABLED=false
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin1!
# BOOTSTRAP_ADMIN_FIRST_NAME=Bootstrap
# BOOTSTRAP_ADMIN_LAST_NAME=Admin

# --- Invitations / password reset / email verify (point at the ACTIVE SPA origin) ---
# React defaults:
# INVITATION_ACCEPT_BASE_URL=http://localhost:5173/invite/accept
# PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
# EMAIL_VERIFY_BASE_URL=http://localhost:5173/verify-email
# Angular alternative:
# INVITATION_ACCEPT_BASE_URL=http://localhost:4200/invite/accept
# PASSWORD_RESET_BASE_URL=http://localhost:4200/reset-password
# EMAIL_VERIFY_BASE_URL=http://localhost:4200/verify-email
# MAIL_FROM=noreply@localhost
# Link tokens (email verify + password reset). Default 10 minutes.
# EMAIL_VERIFY_TOKEN_TTL=10m
# PASSWORD_RESET_TOKEN_TTL=10m


# --- Email outbox AES-GCM KEK (32-byte key, Base64). Generate: openssl rand -base64 32 ---
# EMAIL_OUTBOX_KEK_ID=local-1
# EMAIL_OUTBOX_KEK=

# --- MFA TOTP secret encryption (32-byte key, Base64). Generate: openssl rand -base64 32 ---
# MFA_SECRET_KEK_ID=local-1
# MFA_SECRET_KEK=
# MFA_ISSUER=enterprise-auth-foundation

# --- Reserved for later phases (do not put real secrets in Git) ---
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=
